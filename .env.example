# .env.example をコピーして .env を作り、OPENAI_API_KEY を入れてください（.env はコミットされません）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- 実行設定（すべて必須） ----
# S&P500 銘柄一覧の取得元と、取得時の User-Agent（Wikipedia は User-Agent がないと 403 を返す）
SP500_URL=https://en.wikipedia.org/wiki/List_of_S%26P_500_companies
# S&P500 の銘柄入れ替え履歴
SP500_HISTORY_URL=https://en.wikipedia.org/wiki/Historical_components_of_the_S%26P_500
USER_AGENT=Mozilla/5.0 (LLM-BLM research script)
# 対象月（各月の1日、YYYY-MM-01）。論文の本番は 2024-06-01 〜 2024-12-01
START_MONTH=2024-06-01
END_MONTH=2024-07-01
# 銘柄（カンマ区切り）。S&P500 全銘柄なら ALL
TICKERS=AAPL,NVDA,JPM,XOM,JNJ
# 1銘柄あたりの質問回数（論文は 30）
N_SAMPLES=30
# 出力先（この下に yfinance/ と responses/ を作る）。「.」だとリポジトリ内の元データを上書きするので注意
OUT_DIR=../LLM-BLM_test_run
# SQLite の DB ファイル（株価・銘柄・LLMの回答を保存）
DB_PATH=data/blm.sqlite
# DB に入れる期間（marketdb/build_db.py）
DB_START_DATE=2023-03-01
DB_END_DATE=2026-09-30
# 財務諸表（marketdb/build_fundamentals.py）。SEC EDGAR から取得。{cik} は10桁の会社番号に置き換わる
EDGAR_FACTS_URL=https://data.sec.gov/api/xbrl/companyfacts/CIK{cik}.json
EDGAR_SUBMISSIONS_URL=https://data.sec.gov/submissions/CIK{cik}.json
# 指数から外れた銘柄の会社番号を探すのに使う
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
# この日以降に終わる決算期を保存する
FUNDAMENTALS_START_DATE=2021-07-01
