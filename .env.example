# .env.example をコピーして .env を作り、OPENAI_API_KEY を入れてください（.env はコミットされません）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- 実行設定（すべて必須） ----
# S&P500 銘柄一覧の取得元と、取得時の User-Agent（Wikipedia は User-Agent がないと 403 を返す）
SP500_URL=https://en.wikipedia.org/wiki/List_of_S%26P_500_companies
# S&P500 の銘柄入れ替え履歴
SP500_HISTORY_URL=https://en.wikipedia.org/wiki/Historical_components_of_the_S%26P_500
# 過去の時点の銘柄一覧を読むための Wikipedia の API と、過去の版の URL（{revid} は版の番号に置き換わる）
WIKIPEDIA_API_URL=https://en.wikipedia.org/w/api.php
WIKIPEDIA_REVISION_URL=https://en.wikipedia.org/w/index.php?oldid={revid}
USER_AGENT=Mozilla/5.0 (LLM-BLM research script)
# LLM に渡す月（各月の1日、YYYY-MM-01）。予想するのはその翌月。論文の本番は 2024-06-01 〜 2024-12-01
START_MONTH=2024-06-01
END_MONTH=2024-07-01
# 銘柄（カンマ区切り）。S&P500 全銘柄なら ALL
TICKERS=AAPL,NVDA,JPM,XOM,JNJ
# 1銘柄あたりの回答の数（論文は 30）。1回のリクエストでまとめて受け取る
N_SAMPLES=30
# 回答のばらつきの大きさ（OpenAI の標準は 1.0。0 にすると全部同じ答えになる）
TEMPERATURE=1.0
# 同時に聞く銘柄の数
MAX_WORKERS=8
# 空なら新しい実行として始める。番号を入れると、その実行の続きから再開する（回答済みの銘柄は飛ばす）
RUN_ID=
# 新しい実行に付けるメモ（何を変えた実行か）
RUN_NOTE=
# SQLite の DB ファイル（株価・銘柄・LLMの回答を保存）
DB_PATH=data/blm.sqlite
# DB に入れる期間（marketdb/build_db.py）
DB_START_DATE=2023-03-01
DB_END_DATE=2026-09-30
# 財務諸表（marketdb/build_fundamentals.py）。SEC EDGAR から取得。{cik} は10桁の会社番号に置き換わる
EDGAR_FACTS_URL=https://data.sec.gov/api/xbrl/companyfacts/CIK{cik}.json
EDGAR_SUBMISSIONS_URL=https://data.sec.gov/submissions/CIK{cik}.json
# 指数から外れた銘柄の会社番号を探すのに使う
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql
# この日以降に終わる決算期を保存する
FUNDAMENTALS_START_DATE=2021-07-01

# ---- 比率の計算（run_blm.py）。使った値は portfolio_runs.params にも保存される ----
# 予想として使う LLM の実行番号（llm_runs.run_id）。その実行の判断日ごとに比率を計算する
BLM_LLM_RUN_ID=1
# 計算する戦略（カンマ区切り）。名前は blm/strategies.py
BLM_STRATEGIES=market_cap,equal_weight,mean_variance,black_litterman,black_litterman_original
# 比率の計算に付けるメモ
BLM_NOTE=
# 予想の重み（市場の均衡の不確かさ = tau × 共分散）。論文は 0.025
BLM_TAU=0.025
# リスク回避度。均衡リターン = これ × 共分散 × 時価総額の比率。目的関数 = リターン − これ/2 × 分散
BLM_RISK_AVERSION=2.5
# 共分散に使う日次リターンの日数（252 = 約1年）
BLM_COV_WINDOW_DAYS=252
# 上の期間のうち、株価がこの割合以上ある銘柄だけを対象にする
BLM_MIN_HISTORY_RATIO=0.5
# 元の実装の係数（戦略 black_litterman_original 用）。日次リターンからそのまま引く無リスク金利と、目的関数のリターンの重み
BLM_ORIGINAL_RISK_FREE_RATE=0.02
BLM_ORIGINAL_RETURN_WEIGHT=0.1
